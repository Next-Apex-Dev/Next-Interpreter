fn main() -> void {
    fn check(cond: bool, label: string) -> void {
        if cond {
            println("PASS: " + label);
        } else {
            println("FAIL: " + label);
        }
    }

    let caught_value_error: bool = false;
    try {
        throw ValueError("test value error");
    }
    catch (ValueError) as e {
        caught_value_error = true;
    }
    check(caught_value_error, "catch (ValueError) catches ValueError");

    let caught_key_error: bool = false;
    try {
        throw KeyError("test key error");
    }
    catch (KeyError) as e {
        caught_key_error = true;
    }
    check(caught_key_error, "catch (KeyError) catches KeyError");

    let not_caught: bool = true;
    try {
        try {
            throw KeyError("should not match");
        }
        catch (ValueError) as e {
            not_caught = false;
        }
    }
    catch (Exception) as e {
    }
    check(not_caught, "catch (ValueError) does NOT catch KeyError");

    let caught_via_mro: bool = false;
    try {
        throw KeyError("mro test");
    }
    catch (Exception) as e {
        caught_via_mro = true;
    }
    check(caught_via_mro, "catch (Exception) catches KeyError via MRO");

    let caught_multi: bool = false;
    try {
        throw IndexError("multi type test");
    }
    catch (KeyError, IndexError) as e {
        caught_multi = true;
    }
    check(caught_multi, "catch (KeyError, IndexError) catches IndexError");

    let caught_multi2: bool = false;
    try {
        throw KeyError("multi type test 2");
    }
    catch (KeyError, IndexError) as e {
        caught_multi2 = true;
    }
    check(caught_multi2, "catch (KeyError, IndexError) catches KeyError");

    let caught_parent: bool = false;
    try {
        throw ZeroDivisionError("zero div");
    }
    catch (ArithmeticError) as e {
        caught_parent = true;
    }
    check(caught_parent, "catch (ArithmeticError) catches ZeroDivisionError via MRO");

    let caught_grandparent: bool = false;
    try {
        throw ZeroDivisionError("zero div 2");
    }
    catch (Exception) as e {
        caught_grandparent = true;
    }
    check(caught_grandparent, "catch (Exception) catches ZeroDivisionError via MRO chain");

    let propagated: bool = false;
    try {
        try {
            throw ValueError("inner");
        }
        catch (KeyError) as e {
            propagated = false;
        }
    }
    catch (ValueError) as e {
        propagated = true;
    }
    check(propagated, "unmatched exception propagates to outer catch");

    let finally_executed: bool = false;
    let outer_caught: bool = false;
    try {
        try {
            throw ValueError("finally test");
        }
        catch (KeyError) as e {
        }
        finally {
            finally_executed = true;
        }
    }
    catch (ValueError) as e {
        outer_caught = true;
    }
    check(finally_executed, "finally executes when catch type doesn't match");
    check(outer_caught, "exception propagates through finally to outer catch");

    let not_caught_multi: bool = true;
    try {
        try {
            throw ValueError("not in multi list");
        }
        catch (KeyError, IndexError) as e {
            not_caught_multi = false;
        }
    }
    catch (Exception) as e {
    }
    check(not_caught_multi, "catch (KeyError, IndexError) does NOT catch ValueError");
}
