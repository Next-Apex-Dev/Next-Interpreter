fn main() -> void {
    let failures: int = 0;

    let d1: dict = dict();
    dict_set(d1, "a", 1);
    dict_set(d1, "b", 2);

    let d2: dict = dict();
    dict_set(d2, "a", 1);
    dict_set(d2, "b", 2);

    let d3: dict = dict();
    dict_set(d3, "a", 1);
    dict_set(d3, "b", 99);

    if d1 == d2 {
        print("PASS: dict value equality - same content");
    } else {
        print("FAIL: dict value equality - same content should be equal");
        failures = failures + 1;
    }

    if d1 == d3 {
        print("FAIL: dict value equality - different values should not be equal");
        failures = failures + 1;
    } else {
        print("PASS: dict value equality - different values not equal");
    }

    let d4: dict = dict();
    dict_set(d4, "a", 1);

    if d1 == d4 {
        print("FAIL: dict value equality - different sizes should not be equal");
        failures = failures + 1;
    } else {
        print("PASS: dict value equality - different sizes not equal");
    }

    let s1: set = set([1, 2, 3]);
    let s2: set = set([3, 2, 1]);
    let s3: set = set([1, 2, 4]);

    if s1 == s2 {
        print("PASS: set value equality - same elements different order");
    } else {
        print("FAIL: set value equality - same elements should be equal regardless of order");
        failures = failures + 1;
    }

    if s1 == s3 {
        print("FAIL: set value equality - different elements should not be equal");
        failures = failures + 1;
    } else {
        print("PASS: set value equality - different elements not equal");
    }

    let nested1: any = [[1, 2], [3, 4]];
    let nested2: any = [[1, 2], [3, 4]];
    let nested3: any = [[1, 2], [3, 5]];

    if nested1 == nested2 {
        print("PASS: nested array value equality");
    } else {
        print("FAIL: nested array value equality - same content should be equal");
        failures = failures + 1;
    }

    if nested1 == nested3 {
        print("FAIL: nested array value equality - different content should not be equal");
        failures = failures + 1;
    } else {
        print("PASS: nested array value equality - different content not equal");
    }

    if d1 != d2 {
        print("FAIL: dict inequality - same content should not be !=");
        failures = failures + 1;
    } else {
        print("PASS: dict inequality - same content is not !=");
    }

    if d1 != d3 {
        print("PASS: dict inequality - different content is !=");
    } else {
        print("FAIL: dict inequality - different content should be !=");
        failures = failures + 1;
    }

    if failures == 0 {
        print("ALL PASS: dict/set value equality");
    } else {
        print("FAILED: " + str(failures) + " tests");
        exit(1);
    }
}