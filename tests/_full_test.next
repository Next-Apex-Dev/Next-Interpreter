// Next1.1 功能补全测试
fn double(x: int) -> int { return x * 2; }
fn inc(x: int) -> int { return x + 1; }
fn id<T>(x: T) -> T { return x; }

struct Point { x: int; y: int; }
enum Color { Red, Green, Blue }

class Animal {
    let name: string;
    fn __init__(self: Animal, n: string) -> void { self.name = n; }
    fn speak(self: Animal) -> string { return self.name + " speaks"; }
}
class Dog extends Animal {
    let breed: string;
    fn __init__(self: Dog, n: string, b: string) -> void {
        super(n);
        self.breed = b;
    }
    fn speak(self: Dog) -> string { return super.speak() + " (woof)"; }
}

fn fib_gen() -> int {
    let a: int = 0;
    let b: int = 1;
    while true {
        yield a;
        let t: int = a + b;
        a = b;
        b = t;
    }
}

class TestCtx {
    let exited: bool;
    fn __init__(self: TestCtx) -> void { self.exited = false; }
    fn __enter__(self: TestCtx) -> void { print("with: enter"); }
    fn __exit__(self: TestCtx, exc: Exception) -> bool { self.exited = true; return true; }
}

fn main() -> void {
    // ===== A. 字典 =====
    print("=== A. Dict ===");
    let d: dict = dict();
    d["apple"] = 3;
    d["banana"] = 5;
    print("dict[apple]=" + str(d["apple"]));
    print("keys: " + str(len(keys(d))));
    print("values: " + str(len(values(d))));
    print("items: " + str(len(items(d))));

    // ===== B. 集合 =====
    print("=== B. Set ===");
    let s: set = set([1, 2, 3, 1]);
    print("set size=" + str(len(s)));
    print("set has 2=" + str(contains(s, 2)));

    // ===== C. 同步文件 I/O =====
    print("=== C. File I/O ===");
    let f: file = open("tests/_full_tmp.txt", "w");
    write(f, "Hello World!");
    close(f);
    let f2: file = open("tests/_full_tmp.txt", "r");
    let content: string = read(f2);
    close(f2);
    print("file read: " + content);

    // ===== D. 泛型 =====
    print("=== D. Generics ===");
    let gi: int = id(42);
    let gs: string = id("hello");
    print("generic id(42)=" + str(gi));
    print("generic id(hello)=" + gs);

    // ===== E. 异常处理 =====
    print("=== E. Exception ===");
    try {
        error("test error");
    } catch (Exception) as e {
        print("caught: " + e.message);
    }

    // ===== F. with 语句 =====
    print("=== F. With ===");
    let ctx: TestCtx = TestCtx();
    with ctx { print("with: inside"); }
    print("with: exited=" + str(ctx.exited));

    // ===== G. async/await =====
    print("=== G. Async ===");
    let w: int = await async_write("tests/_full_async.txt", "async data");
    print("async write: " + str(w) + " bytes");
    let r: string = await async_read("tests/_full_async.txt");
    print("async read: " + r);

    // ===== H. 元组 =====
    print("=== H. Tuples ===");
    let t: (int, string) = (42, "answer");
    let (num, txt) = t;
    print("tuple: " + str(num) + " " + txt);

    // ===== I. 管道 =====
    print("=== I. Pipe ===");
    let p: int = 5 |> double |> inc;
    print("pipe: " + str(p));

    // ===== J. 生成器 =====
    print("=== J. Generator ===");
    let g: int = fib_gen();
    print("fib: " + str(next(g)) + " " + str(next(g)) + " " + str(next(g)) + " " + str(next(g)) + " " + str(next(g)));

    // ===== K. 类型系统 =====
    print("=== K. Type System ===");
    let d2: Dog = Dog("Rex", "Lab");
    print("isinstance(dog,Animal)=" + str(isinstance(d2, "Animal")));
    print("isinstance(dog,Dog)=" + str(isinstance(d2, "Dog")));
    print("issubtype(Dog,Animal)=" + str(issubtype("Dog", "Animal")));
    print("type_of(dog)=" + type_of(d2));
    print("callable(double)=" + str(callable(double)));

    // ===== L. hash 扩展 =====
    print("=== L. Hash ===");
    print("hash(int)=" + str(hash(42)));
    print("hash(string)=" + str(hash("abc")));
    print("hash(array)=" + str(hash([1, 2, 3])));
    print("hash(complex)=" + str(hash(3+4i)));

    // ===== M. 数学扩展 =====
    print("=== M. Math ===");
    print("lcm(4,6)=" + str(lcm(4, 6)));
    print("hypot(3,4)=" + str(hypot(3.0, 4.0)));
    print("fibonacci(10)=" + str(fibonacci(10)));
    print("deg2rad(180)=" + str(deg2rad(180.0)));

    // ===== N. 字符串扩展 =====
    print("=== N. Strings ===");
    print("pad_left: [" + pad_left("42", 5, "0") + "]");
    print("pad_right: [" + pad_right("42", 5, " ") + "]");
    print("reverse_str: " + reverse_str("hello"));
    print("repeat_str: " + repeat_str("ab", 3));
    print("to_hex: " + to_hex(255));
    print("from_hex: " + str(from_hex("FF")));

    // ===== O. 数组扩展 =====
    print("=== O. Arrays ===");
    let arr: int[] = [1, 2, 3, 4, 5, 6, 7, 8];
    print("take: " + str(take(arr, 3)[2]));
    print("drop: " + str(drop(arr, 5)[0]));
    print("chunk: " + str(len(chunk(arr, 3))));
    print("distinct: " + str(len(distinct([1, 1, 2, 3, 3]))));
    print("rotate: " + str(rotate([1, 2, 3], 1)[0]));

    print("");
    print("=== ALL COMPREHENSIVE TESTS PASSED ===");
}
