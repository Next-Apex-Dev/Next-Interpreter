// next 1.1 - 函数与控制流
fn add(a: int, b: int) -> int {
    return a + b;
}

fn fib(n: int) -> int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> void {
    print(add(3, 4));
    print(fib(10));
    let i: int = 0;
    let sum: int = 0;
    while (i < 5) {
        sum = sum + i;
        i = i + 1;
    }
    print(sum);
    for (x in [10, 20, 30]) {
        print(x);
    }
}