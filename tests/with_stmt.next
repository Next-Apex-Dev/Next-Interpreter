class FileManager {
    let name: string;
    let opened: bool;
    fn __init__(self: FileManager, n: string) -> void {
        self.name = n;
        self.opened = false;
    }
    fn __enter__(self: FileManager) -> string {
        self.opened = true;
        return self.name;
    }
    fn __exit__(self: FileManager, exc: any) -> bool {
        self.opened = false;
        return false;
    }
}

class NoEnter {
    let x: int;
    fn __init__(self: NoEnter, v: int) -> void {
        self.x = v;
    }
    fn __exit__(self: NoEnter, exc: any) -> bool {
        return false;
    }
}

class NoExit {
    let x: int;
    fn __init__(self: NoExit, v: int) -> void {
        self.x = v;
    }
    fn __enter__(self: NoExit) -> int {
        return self.x;
    }
}

fn main() -> void {
    fn check(cond: bool, label: string) -> void {
        if cond {
            println("PASS: " + label);
        } else {
            println("FAIL: " + label);
        }
    }

    let fm: FileManager = FileManager("test.txt");
    with fm as name {
        check(fm.opened, "with calls __enter__ and sets opened=true");
        check(name == "test.txt", "with binds __enter__ result to as variable");
    }
    check(!fm.opened, "with calls __exit__ and sets opened=false");

    let caught_no_enter: bool = false;
    try {
        let ne: NoEnter = NoEnter(42);
        with ne as x {
            check(false, "should not reach here - NoEnter has no __enter__");
        }
    }
    catch (Exception) as e {
        caught_no_enter = true;
    }
    check(caught_no_enter, "with on struct without __enter__ throws error");

    let caught_no_exit: bool = false;
    try {
        let nx: NoExit = NoExit(42);
        with nx as x {
        }
    }
    catch (Exception) as e {
        caught_no_exit = true;
    }
    check(caught_no_exit, "with on struct without __exit__ throws error");

    let caught_non_struct: bool = false;
    try {
        with 42 as x {
            check(false, "should not reach here - int is not a context manager");
        }
    }
    catch (Exception) as e {
        caught_non_struct = true;
    }
    check(caught_non_struct, "with on non-struct (int) throws error");

    let exc_propagated: bool = false;
    let fm2: FileManager = FileManager("exc_test.txt");
    try {
        with fm2 as name {
            throw ValueError("test exception in with");
        }
    }
    catch (ValueError) as e {
        exc_propagated = true;
    }
    check(exc_propagated, "exception in with block propagates after __exit__");
    check(!fm2.opened, "__exit__ called even when exception occurs");

    let caught_non_callable: bool = false;
    try {
        let x: int = 42;
        let y: int = x(10);
    }
    catch (Exception) as e {
        caught_non_callable = true;
    }
    check(caught_non_callable, "calling non-function value (int) throws error");
}
