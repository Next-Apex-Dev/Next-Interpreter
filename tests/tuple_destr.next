// 元组解构测试
fn make_pair(a: int, b: int) -> (int, int) {
  return (a, b);
}

fn main() -> void {
  let t: (int, string) = (42, "hello");
  let (a, b) = t;
  print(a);
  print(b);

  let p: (int, int) = make_pair(3, 7);
  let (x, y) = p;
  print(x);
  print(y);

  let (i, s) = (100, "world");
  print(i);
  print(s);

  let nested: (int, (int, int)) = (1, (2, 3));
  let (n, (m, k)) = nested;
  print(n);
  print(m);
  print(k);
}