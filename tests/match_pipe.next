// next 1.1 - 模式匹配与管道
fn double(x: int) -> int {
    return x * 2;
}

fn inc(x: int) -> int {
    return x + 1;
}

fn classify(n: int) -> string {
    return match n {
        0 => "zero",
        1 => "one",
        _ => "many",
    };
}

fn main() -> void {
    print(classify(0));
    print(classify(1));
    print(classify(5));
    print(5 |> double);
    print(5 |> inc |> double);
    print(10 |> double);
}