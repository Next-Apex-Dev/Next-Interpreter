// 测试5：复杂数据结构、嵌套结构体、字符串数组、复杂match
struct Vec2 {
  x: float;
  y: float;
}

struct Box {
  pos: Vec2;
  size: Vec2;
}

fn add_vec(a: Vec2, b: Vec2) -> Vec2 {
  return Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn scale_vec(v: Vec2, s: float) -> Vec2 {
  return Vec2 { x: v.x * s, y: v.y * s };
}

fn vec_len(v: Vec2) -> float {
  return v.x * v.x + v.y * v.y;
}

fn double_arr(arr: int[]) -> int[] {
  let result: int[] = [];
  for v in arr {
    result = result + [v * 2];
  }
  return result;
}

fn main() -> void {
  // 向量运算
  let v1: Vec2 = Vec2 { x: 1.0, y: 2.0 };
  let v2: Vec2 = Vec2 { x: 3.0, y: 4.0 };
  let v3: Vec2 = add_vec(v1, v2);
  print(v3.x);
  print(v3.y);

  let v4: Vec2 = scale_vec(v1, 2.5);
  print(v4.x);
  print(v4.y);

  print(vec_len(v1));
  print(vec_len(v2));

  // 嵌套结构体
  let box: Box = Box {
    pos: Vec2 { x: 0.0, y: 0.0 },
    size: Vec2 { x: 10.0, y: 20.0 },
  };
  print(box.pos.x);
  print(box.pos.y);
  print(box.size.x);
  print(box.size.y);

  // 数组运算
  let arr: int[] = [1, 2, 3, 4, 5];
  let doubled: int[] = double_arr(arr);
  for v in doubled {
    print(v);
  }

  // 字符串数组
  let names: string[] = ["Alice", "Bob", "Charlie"];
  for name in names {
    print(name);
  }
  print(len(names));

  // match with complex guard
  let n: int = 15;
  let result: string = match n {
    x if x < 0 => "negative",
    0 => "zero",
    x if x < 10 => "small",
    x if x < 100 => "medium",
    _ => "large",
  };
  print(result);

  // 多分支match
  let day: int = 3;
  let day_name: string = match day {
    1 => "Monday",
    2 => "Tuesday",
    3 => "Wednesday",
    4 => "Thursday",
    5 => "Friday",
    _ => "Weekend",
  };
  print(day_name);
}
